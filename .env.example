NODE_ENV=development
DATABASE_URL=postgres://postgres:postgres@localhost:5432/main
SHADOW_DATABASE_URL=postgres://postgres:postgres@localhost:5432/shadowmain
REDIS_URL=redis://127.0.0.1:6379
SESSION_SECRET=change_me
TELEGRAM_BOT_TOKEN=paste your bot token
LOGIN_PAGE_URL=https://example.com/loginPage.html
# MAX login page URL (for token delivery via mini-app)
MAX_LOGIN_PAGE_URL=https://example.com/maxLoginPage.html
# These apply to all transports, not just Telegram
TELEGRAM_TOKENS_REFRESH_INTERVAL_SEC=60
TELEGRAM_TOKENS_REFRESH_BEFORE_SEC=180
TELEGRAM_TOKENS_TTL_SEC=600
FORCE_ACCESS_TOKEN_TTL=true
ENABLE_DB_LOGS=true
TOKENS_ENCRYPTION_KEY=someRandomString32SymbolsLength!
# MAX transport (optional — at least one transport token is required)
MAX_BOT_TOKEN=
# MAX bot username (without @) for deep links
MAX_BOT_USERNAME=se13902840_bot
# MAX webhook URL for production (optional, uses long polling if not set)
# MAX_BOT_WEBHOOK_URL=https://your-domain.com/webhooks/max
# MAX_BOT_WEBHOOK_SECRET=your_secret_for_webhook_validation
